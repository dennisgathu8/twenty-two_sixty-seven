{:paths ["src" "resources"]
 :deps
 {org.clojure/clojure {:mvn/version "1.12.0"}
  org.clojure/spec.alpha {:mvn/version "0.5.238"}
  org.clojure/core.logic {:mvn/version "1.0.1"}
  org.clojure/core.async {:mvn/version "1.6.681"}
  com.xtdb/xtdb-core {:mvn/version "1.24.4"}
  com.xtdb/xtdb-rocksdb {:mvn/version "1.24.4"}
  http-kit/http-kit {:mvn/version "2.8.0"}
  metosin/reitit {:mvn/version "0.7.2"}
  ring/ring-core {:mvn/version "1.14.1"}
  org.apache.commons/commons-fileupload2-core {:mvn/version "2.0.0-M4"}
  com.fasterxml.jackson.core/jackson-core {:mvn/version "2.18.11"}
  com.fasterxml.jackson.core/jackson-databind {:mvn/version "2.18.11"}
  com.fasterxml.jackson.core/jackson-annotations {:mvn/version "2.18.11"}
  com.fasterxml.jackson.dataformat/jackson-dataformat-cbor {:mvn/version "2.18.11"}
  com.fasterxml.jackson.dataformat/jackson-dataformat-smile {:mvn/version "2.18.11"}
  com.fasterxml.jackson.datatype/jackson-datatype-jsr310 {:mvn/version "2.18.11"}
  ring/ring-defaults {:mvn/version "0.5.0"}
  hiccup/hiccup {:mvn/version "2.0.0-RC3"}
  buddy/buddy-sign {:mvn/version "3.5.351"}
  buddy/buddy-auth {:mvn/version "3.0.323"}
  org.clojure/data.csv {:mvn/version "1.1.0"}
  org.clojure/data.json {:mvn/version "2.5.1"}
  org.clojure/tools.logging {:mvn/version "1.3.0"}
  org.slf4j/slf4j-nop {:mvn/version "1.7.36"}}

 :aliases
 {:dev
  {:extra-paths ["dev"]
   :extra-deps
   {org.clojure/tools.namespace {:mvn/version "1.4.4"}
    nrepl/nrepl {:mvn/version "1.3.0"}}}

  :test
  {:extra-paths ["test"]
   :extra-deps
   {org.clojure/test.check {:mvn/version "1.1.1"}
    ring/ring-mock {:mvn/version "0.4.0"}}
   :main-opts ["-m" "bwr.test-runner"]}

  :clj-watson
  {:replace-deps {io.github.clj-holmes/clj-watson {:git/tag "v6.1.0"
                                                   :git/sha "be98e4db74fb8927db4825cc73bbe2606e44e5e3"}}
   :main-opts ["-m" "clj-watson.cli"]}

  :repl
  {:main-opts ["-m" "nrepl.cmdline" "--interactive"]}}}
