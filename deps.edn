{:paths ["src" "resources"]
 :deps
 {org.clojure/clojure {:mvn/version "1.12.0"}
  org.clojure/spec.alpha {:mvn/version "0.5.238"}
  org.clojure/core.logic {:mvn/version "1.0.1"}
  org.clojure/core.async {:mvn/version "1.6.681"}
  com.xtdb/xtdb-core {:mvn/version "1.24.4"}
  com.xtdb/xtdb-rocksdb {:mvn/version "1.24.4"}
  http-kit/http-kit {:mvn/version "2.8.0"}
  metosin/reitit {:mvn/version "0.7.2"}
  ring/ring-core {:mvn/version "1.14.1"}
  ring/ring-defaults {:mvn/version "0.5.0"}
  hiccup/hiccup {:mvn/version "2.0.0-RC3"}
  buddy/buddy-sign {:mvn/version "3.5.351"}
  buddy/buddy-auth {:mvn/version "3.0.323"}
  org.clojure/data.csv {:mvn/version "1.1.0"}
  org.clojure/data.json {:mvn/version "2.5.1"}}

 :aliases
 {:dev
  {:extra-paths ["dev"]
   :extra-deps
   {org.clojure/tools.namespace {:mvn/version "1.4.4"}
    nrepl/nrepl {:mvn/version "1.3.0"}}}

  :test
  {:extra-paths ["test"]
   :extra-deps
   {org.clojure/test.check {:mvn/version "1.1.1"}
    ring/ring-mock {:mvn/version "0.4.0"}}
   :main-opts ["-m" "bwr.test-runner"]}

  :repl
  {:main-opts ["-m" "nrepl.cmdline" "--interactive"]}}}
